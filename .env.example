# ─── Doispalitos — Variáveis de Ambiente (desenvolvimento local) ─────────────
# NUNCA commitar este arquivo com valores reais.
# Copie para .env e preencha os valores.

APP_NAME="Doispalitos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR

# ─── Banco de Dados ───────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=doispalitos
DB_USERNAME=doispalitos
DB_PASSWORD=secret

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=secret
REDIS_PORT=6379

# ─── Cache / Sessão / Filas ───────────────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
QUEUE_CONNECTION=redis

# ─── Email (Mailpit em dev) ───────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@doispalitos.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Filesystem / Storage ────────────────────────────────────────────────────
FILESYSTEM_DISK=local
# Em produção, trocar para 's3' e preencher:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT=https://...r2.cloudflarestorage.com
# AWS_URL=

# ─── Mercado Pago (preencher quando for à fase 6) ────────────────────────────
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=

# ─── Google Maps (preencher quando for à fase 5) ─────────────────────────────
# GOOGLE_MAPS_API_KEY=

# ─── Laravel Reverb (WebSockets — fase 4) ────────────────────────────────────
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http

# ─── Broadcast ───────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
