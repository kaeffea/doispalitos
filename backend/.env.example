# ─── Doispalitos — Variáveis de Ambiente (desenvolvimento local) ─────────────
# NUNCA commitar este arquivo com valores reais.
# Copie para .env e preencha os valores.

APP_NAME="Doispalitos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_DOMAIN=doispalitos.tech
FRONTEND_URL=https://app.doispalitos.tech

# ─── Banco de Dados ───────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=doispalitos
DB_USERNAME=doispalitos
DB_PASSWORD=secret

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=secret
REDIS_PORT=6379

# ─── Cache / Sessão / Filas ───────────────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
QUEUE_CONNECTION=redis

# ─── Email (Mailpit em dev) ───────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@doispalitos.tech"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Filesystem / Storage ────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ─── Broadcast ───────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log

# ─── Vercel (domínios automáticos da vitrine — conta Hobby sem wildcard) ─────
# Token em: Vercel → Account Settings → Tokens → Create (sem expiração, scope full).
# Sem token, o cadastro de restaurantes funciona normal, só não registra o domínio.
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=doispalitos-storefront
# VERCEL_TEAM_ID=
